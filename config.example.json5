{
  // Global DHCP server configuration
  //
  // Note: This daemon uses raw sockets (AF_PACKET) to capture broadcast DHCP packets
  // from clients without IP addresses. This requires root privileges or CAP_NET_RAW.
  //
  "global": {
    "lease_time": 86400,               // 24 hours in seconds
    "netbios_node_type": 8,            // 8 = H-node (recommended)
    "ping_timeout": 1000,              // milliseconds
    "ping_retries": 2,
    "database_path": "/var/lib/go-dhcpd/dhcpd.db",
    "listen_address": "192.168.1.1",   // IP address for UDP port 67 (unicast/relay traffic)
    "listen_interface": "",            // Network interface to bind to (e.g., "eth0", "ens33")
                                       // Leave empty to listen on all interfaces
                                       // Restricts both raw socket and UDP listeners
    "api_port": 18467
  },

  // API authorization
  //
  // /health, /version and the /metrics endpoints are always unauthenticated.
  // Every other endpoint (config, subnets, static hosts, leases, deny list)
  // requires HTTP Basic Auth, checked against the host's local users via
  // PAM (service name "go-dhcpd"; see pam.d/ in the repo). root is always
  // authorized; allowed_users/allowed_groups grant additional accounts.
  "auth": {
    "allowed_users": ["admin"],
    "allowed_groups": ["go-dhcpd-admins"]
  },

  // Plugin configuration
  //
  // go-dhcpd loads subnets and static leases through an external
  // "config_provider" plugin, invoked as an independent binary. The
  // bundled "file" plugin reads subnets/static hosts from this same
  // config.json5 file and is read-only: it does not support write
  // operations via the API. Future plugins (e.g. database-backed) can
  // support write access.
  "plugins": {
    "config_provider": {
      "name": "file",
      // "path" is optional; when omitted it defaults to
      // "<install_prefix>/lib/go-dhcpd/plugins/file-config.plugin",
      // using the prefix the dhcpd binary was built/installed with
      // (see Makefile's INSTALL_PREFIX). Set it explicitly to override.
      "settings": {
        // Defaults to the config file passed on the command line if omitted
        // only set this if you want to override the default config file path
        // "config_path": "/etc/go-dhcpd/config.json5"
      }
    }
  },

  // Subnet definitions
  "subnets": [
    {
      "network": "192.168.1.0",
      "netmask": "255.255.255.0",
      // Dynamic IP allocation ranges
      // Each range specifies a start and end address
      // Example: 192.168.1.100 - 192.168.1.163 provides 64 usable IP addresses
      "dynamic_ranges": [
        {
          "start_address": "192.168.1.100",
          "end_address": "192.168.1.163"
        }
      ],
      "enable_bootp": false,
      "domain_name_servers": ["192.168.1.1", "8.8.8.8"],
      "domain_name": "example.local",
      "domain_search": ["example.local", "example.com"],
      "interface_mtu": 1500,
      "ntp_servers": ["192.168.1.1"],
      "routers": ["192.168.1.1"],
      "netbios_name_servers": ["192.168.1.10"],
      "netbios_dd_servers": ["192.168.1.10"],
      "netbios_node_type": 8
    }
  ],

  // Static host assignments
  "static": [
    {
      "mac_address": "aa:bb:cc:dd:ee:ff",
      "ip_address": "192.168.1.10",
      "hostname": "server1.example.local"
    },
    {
      "mac_address": "11:22:33:44:55:66",
      "ip_address": "192.168.1.11",
      "hostname": "server2.example.local"
    }
  ]
}
